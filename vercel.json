{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "media": {
      "root": "media",
      "framework": "bun",
      "entrypoint": "server.ts",
      "installCommand": "bun install"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "bun install",
      "buildCommand": "bun run build"
    }
  },
  "rewrites": [
    {
      "source": "/media/(.*)",
      "destination": {
        "service": "media"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
